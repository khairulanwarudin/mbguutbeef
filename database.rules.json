{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('metadata').child('role').val() == 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('metadata').child('role').val() == 'admin')",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('metadata').child('role').val() == 'admin')"
      }
    },
    "device_owners": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() == auth.uid || root.child('users').child(auth.uid).child('metadata').child('role').val() == 'admin')"
      }
    },
    "tickets": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('metadata').child('isApproved').val() == true",
      ".write": "auth != null && root.child('users').child(auth.uid).child('metadata').child('isApproved').val() == true",
      "$ticket_id": {
        ".validate": "newData.hasChildren(['uid', 'email', 'deviceId', 'description', 'status'])"
      }
    },
    "devices": {
      "$deviceId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('metadata').child('role').val() == 'admin' || root.child('users').child(auth.uid).child('devices').child($deviceId).val() != null)",
        ".write": "auth != null && root.child('users').child(auth.uid).child('metadata').child('role').val() == 'admin'"
      }
    }
  }
}